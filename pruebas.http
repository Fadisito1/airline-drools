### TEST 1 - Upgrade a ejecutiva (Gold + retraso 90). Esperado: upgradedToBusiness = true
POST http://localhost:8080/airline/evaluate
Content-Type: application/json

{"passenger":{"name":"Test1","age":50,"membershipStatus":"Gold","luggageWeight":15,"seatPreference":"Window","travelingWithChildren":false,"loyaltyPoints":0},"flight":{"flightNumber":"AV001","delayMinutes":90,"durationHours":3},"seats":[{"number":"12A","emergencyExit":true,"occupied":false},{"number":"14C","emergencyExit":false,"occupied":false}]}

### TEST 2 - Check-in prioritario (edad 70). Esperado: priorityCheckIn = true
POST http://localhost:8080/airline/evaluate
Content-Type: application/json

{"passenger":{"name":"Test2","age":70,"membershipStatus":"Basic","luggageWeight":15,"seatPreference":"Window","travelingWithChildren":false,"loyaltyPoints":0},"flight":{"flightNumber":"AV002","delayMinutes":0,"durationHours":3},"seats":[{"number":"12A","emergencyExit":true,"occupied":false}]}

