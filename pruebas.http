POST http://localhost:8080/airline/evaluate
Content-Type: application/json

{"passenger":{"name":"Test3","age":50,"membershipStatus":"Basic","luggageWeight":8,"seatPreference":"Window","travelingWithChildren":false,"loyaltyPoints":0},"flight":{"flightNumber":"AV003","delayMinutes":0,"durationHours":3},"seats":[{"number":"12A","emergencyExit":true,"occupied":false}]}

